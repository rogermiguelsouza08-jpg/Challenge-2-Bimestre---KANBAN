<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.miltinho</groupId>
    <artifactId>miltinho-manager</artifactId>
    <version>1.0.0</version>
    <name>miltinho-manager</name>
    <description>
        Miltinho Manager - Sistema de gestao de pedidos para o Bar e Restaurante Miltinho.
        Projeto Challenge 2o Bimestre - Startup TechVision.
    </description>

    <properties>
        <java.version>17</java.version>
        <!-- Necessario para o NetBeans/exec-maven-plugin saber qual classe executar -->
        <start-class>com.miltinho.manager.MiltinhoApp</start-class>
    </properties>

    <dependencies>
        <!-- Camada web minima: usada apenas para expor o console do H2 (/h2-console) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistencia: Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Banco de dados H2 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Validacao de campos (opcional, usado nos formularios) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Testes -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>miltinho-manager</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Configuracao para o NetBeans saber qual classe executar -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>com.miltinho.manager.MiltinhoApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
